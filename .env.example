# ── Database — Neon Tech (https://neon.tech) ─────────────────────────────
# Neon standard connection (FastAPI + asyncpg):
DATABASE_URL=postgresql+asyncpg://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# Neon pooled connection (Alembic migrations, PgBouncer):
DATABASE_URL_POOLED=postgresql+asyncpg://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Redis — Upstash (https://upstash.com) hoặc local:
REDIS_URL=rediss://:your-upstash-password@your-endpoint.upstash.io:6380
# Local Redis: REDIS_URL=redis://localhost:6379/0

# ── KymaAPI (AI Gateway) ─────────────────────────────────────────────────
KYMAAPI_KEY=your_kyma_api_key
KYMAAPI_BASE_URL=https://api.kymaapi.com/v1

# ── Image Generation ──────────────────────────────────────────────────────
COMFYUI_URL=http://127.0.0.1:8188
CHATFPT_IMAGE_API_KEY=your_chatfpt_key
BANANA_API_KEY=your_banana_key

# ── Video Generation ──────────────────────────────────────────────────────
# Via KymaAPI — model selection in code (Seedance, Kling, etc.)

# ── Audio ─────────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=your_elevenlabs_key
OPENAI_API_KEY=your_openai_key

# ── Music ─────────────────────────────────────────────────────────────────
SUNO_API_KEY=your_suno_key
SUNO_API_BASE_URL=https://api.sunoapi.com/api/v1

# ── Cloudflare R2 ─────────────────────────────────────────────────────────
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=aicfs-media
R2_PUBLIC_URL=https://your_bucket.r2.cloudflarestorage.com

# ── YouTube Data API ──────────────────────────────────────────────────────
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_API_KEY=your_youtube_data_api_key

# ── Notifications ─────────────────────────────────────────────────────────
GMAIL_SERVICE_ACCOUNT_JSON=path/to/service_account.json
NOTIFICATION_EMAIL=kelvinhuannguyen@gmail.com
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ── RunPod (GPU backup) ───────────────────────────────────────────────────
RUNPOD_COMFYUI_URL=https://igtmboxet83luj-8188.proxy.runpod.net

# ── App ───────────────────────────────────────────────────────────────────
APP_SECRET_KEY=change_this_to_a_random_secret
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
